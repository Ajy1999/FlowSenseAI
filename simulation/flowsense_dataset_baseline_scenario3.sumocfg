<configuration>
    <input><net-file value="network.net.xml"/><route-files value="dataset_routes_scenario3.rou.xml"/></input>
    <time><begin value="0"/><end value="3600"/><step-length value="1"/></time>
    <processing><time-to-teleport value="-1"/></processing>
    <output><tripinfo-output value="dataset_baseline_scenario3_tripinfo.xml"/></output>
    <report><verbose value="true"/><no-step-log value="true"/></report>
</configuration>
